#include <iostream>

using namespace std;

int main() {
    double a, b, c;

    // Solicitar valores al usuario
    cout << "Ingrese el valor de a: ";
    cin >> a;
    cout << "Ingrese el valor de b: ";
    cin >> b;
    cout << "Ingrese el valor de c: ";
    cin >> c;

    // Evaluando las condiciones
    if (a == 0 && b == 0 && c == 0) {
        cout << "Los valores no indican figura." << endl;
    }
    else if ((a > 0 && b == 0 && c == 0) || (a == 0 && b > 0 && c == 0) || (a == 0 && b == 0 && c > 0)) {
        cout << "La figura es un circulo." << endl;
    }
    else if ((a == b && c == 0 && a > 0) || (a == c && b == 0 && a > 0) || (b == c && a == 0 && b > 0)) {
        cout << "La figura es un cuadrado." << endl;
    }
    else if ((a != b && c == 0 && a > 0 && b > 0) || (a != c && b == 0 && a > 0 && c > 0) || (b != c && a == 0 && b > 0 && c > 0)) {
        cout << "La figura es un rectangulo." << endl;
    }
    else if (a == b && b == c && a > 0) {
        cout << "La figura es un triangulo equilatero." << endl;
    }
    else if (((a == b && a != c) || (a == c && a != b) || (b == c && b != a)) && a > 0 && b > 0 && c > 0) {
        cout << "La figura es un triangulo isoceles." << endl;
    }
    else if (a != b && b != c && a != c && a > 0 && b > 0 && c > 0) {
        cout << "La figura es un triangulo escaleno." << endl;
    }
    else {
        cout << "Los valores no indican una figura valida." << endl;
    }

    return 0;
}
